// The module's own config, used by nf-test. Consuming pipelines never include
// this file (its manifest would overwrite theirs); they include
// conf/module.config instead.
manifest {
    name            = 'nf-mod-interop'
    description     = 'Nextflow module for Illumina InterOp run metrics'
    version         = '0.0.0'
    nextflowVersion = '!>=26.04.4'
}

// run_metrics/ ships its script in resources/usr/bin/. Consuming pipelines need
// this line too; see the README.
nextflow.enable.moduleBinaries = true
